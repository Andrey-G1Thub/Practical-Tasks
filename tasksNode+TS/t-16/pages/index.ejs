<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  -
  <body>
    <main class="container">
      <header class="header">
        <h1><%= title %></h1>
        <p class="subtitle">Управляйте своими заметками</p>
      </header>

      <form id="add-note-form" class="add-note-form">
        <input
          type="text"
          id="note-title"
          name="title"
          placeholder="Введите название заметки"
          required
        />
        <button type="submit">Добавить заметку</button>
      </form>

      <p id="error-message"></p>

      <section id="notes-list" class="notes-list"></section>
    </main>

    <script src="/app.js" defer></script>
  </body>
</html>
